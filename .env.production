# Configuración del BUILD DE PRODUCCIÓN. Vite le da prioridad sobre .env.local,
# así que lo de acá es lo que termina en dist/ aunque en la máquina haya un
# .env.local apuntando al proxy de desarrollo.
#
# El portal se sirve bajo festivaldanzarte.com/portal/ y su backend PHP vive en
# /portal/api. Sin esta línea, .env.local (VITE_API_URL=/api, que es lo correcto
# en dev porque ahí el proxy escucha en /api) haría que el build apuntara a
# festivaldanzarte.com/api — que no existe — y el portal quedaría sin backend.
VITE_API_URL=/portal/api
